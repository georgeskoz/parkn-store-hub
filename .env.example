# Required Vite env vars for Vercel deployment.
# In Vercel: Project Settings → Environment Variables → add these for Production, Preview, and Development.

VITE_SUPABASE_PROJECT_ID="skfaqjatbqrmfkojtqsz"
VITE_SUPABASE_URL="https://skfaqjatbqrmfkojtqsz.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<copy from current Lovable .env>"

# Google Static Maps API — powers the hero background map (src/components/HeroMap.tsx).
# Separate from mobile's EXPO_PUBLIC_GOOGLE_MAPS_API_KEY (that one is app-restricted
# by bundle ID and won't work in a browser). Create a new key in the same GCP project,
# restricted by HTTP referrer to spotsvault.com/* and www.spotsvault.com/*, scoped to
# the Static Maps API only. If unset, the hero falls back to the static photo background.
VITE_GOOGLE_MAPS_STATIC_KEY=""

# Server-side only (no VITE_ prefix — never bundled into the client build). Used by
# api/hero-map.ts, the edge function that fetches and CDN-caches a per-visitor-city map
# on the visitor's behalf (a browser can't send a referrer-restricted key server-to-
# server, so this can reuse the same key value as VITE_GOOGLE_MAPS_STATIC_KEY above —
# see the comment in api/hero-map.ts for why that currently works). If unset, that
# endpoint returns 503 and the hero silently keeps showing the Montreal fallback.
GOOGLE_MAPS_STATIC_KEY=""
